Xm31 wdata31 weclk m31 VDD VSS MEMBIT
Br31 rdata31 0 V={v(re)>1.65 ? v(m31) : 0}
.ic v(m0)=0 v(m1)=0
.tran 1u 150u uic
.control
set filetype=ascii
run
meas tran r0 FIND v(rdata0) AT=120u
meas tran r1 FIND v(rdata1) AT=120u
.endc
.end
